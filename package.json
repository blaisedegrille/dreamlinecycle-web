{
  "name": "dreamlinecycle-web",
  "version": "1.0.0",
  "private": true,
  "description": "Dreamline Cycle — custom bicycle workshop in Pécs. Static multilingual website.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "npm run content && next dev",
    "build": "npm run content && next build",
    "start": "node scripts/serve-static.mjs",
    "content": "node scripts/make-placeholders.mjs && node scripts/sync-gallery.mjs && node scripts/make-og.mjs && node scripts/make-rss.mjs",
    "gallery": "node scripts/sync-gallery.mjs",
    "og": "node scripts/make-og.mjs",
    "rss": "node scripts/make-rss.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@next/third-parties": "^16.4.3",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
